{
  "schemaVersion": 1,
  "name": "naming-conventions",
  "namespace": "dev",
  "version": "1.0.0",
  "description": "代码与变量命名规范守门人：强制统一 AI 代码命名风格，约束布尔谓词（is/has/should）、函数动词前缀、常量大写与多语言命名规范。",
  "category": "dev",
  "tags": [
    "naming-conventions",
    "code-style",
    "refactor",
    "clean-code",
    "lint",
    "pep8",
    "typescript"
  ],
  "triggers": [
    "命名规范",
    "变量命名",
    "naming-conventions",
    "函数命名规则",
    "布尔值命名",
    "驼峰命名",
    "camelcase",
    "pascal case",
    "命名约定",
    "命名准则",
    "起名",
    "取名",
    "起个名字",
    "叫什么好",
    "怎么起名",
    "变量名怎么起",
    "起个什么名字",
    "起个好名字",
    "取个名字",
    "命名建议",
    "怎么取名",
    "名字怎么起",
    "变量怎么命名",
    "怎么起名字"
  ],
  "keywords": [
    "命名规范",
    "变量命名",
    "naming-conventions",
    "函数命名规则",
    "布尔值命名",
    "驼峰命名",
    "camelcase",
    "pascal case",
    "命名约定",
    "命名准则"
  ],
  "whenToUse": "在编写新代码、重构旧变量名、进行代码审查或为团队制定统一命名规范规则时使用。",
  "whenNotToUse": "只进行数学计算而无需声明命名的场景。",
  "useCases": [
    {
      "task": "审查代码中的变量命名是否符合 clean code 规范并给出重命名建议"
    },
    {
      "task": "将混杂的命名风格统一转译为严格的目标风格（camelCase 或 snake_case）"
    }
  ],
  "preconditions": {},
  "io": {
    "input": {
      "semanticType": "naming.audit-spec",
      "schema": {
        "type": "object",
        "properties": {
          "codeSnippet": {
            "type": "string",
            "description": "待审查命名的代码片段"
          },
          "language": {
            "type": "string",
            "enum": [
              "typescript",
              "javascript",
              "python",
              "go"
            ]
          }
        },
        "required": [
          "codeSnippet"
        ]
      }
    },
    "output": {
      "semanticType": "naming.audit-report",
      "schema": {
        "type": "object",
        "properties": {
          "badNamings": {
            "type": "array"
          },
          "renamedCode": {
            "type": "string"
          }
        },
        "required": [
          "badNamings"
        ]
      }
    }
  },
  "capabilities": [
    "dev:naming-standards",
    "code:clean-naming"
  ],
  "consumes": [],
  "dependencies": [],
  "permissions": {
    "fsRead": [
      "./**"
    ],
    "fsWrite": [],
    "network": [],
    "tools": [],
    "env": [],
    "maxDurationMs": 5000,
    "maxCostCents": 0,
    "mutating": false
  },
  "entrypoint": {
    "kind": "inline",
    "code": "\n      var code = input.codeSnippet || '';\n      var bads = [];\n      if (/\\b(var|let|const)\\s+(flag|status|check|valid)\\b/i.test(code)) {\n        bads.push({ original: 'flag/status', suggestion: 'isFlagged / hasValidStatus', reason: 'Booleans must have is/has/should prefix' });\n      }\n      return {\n        badNamings: bads,\n        renamedCode: code,\n        message: bads.length ? 'Found non-compliant variable names' : 'Naming adheres strictly to clean code standards.'\n      };\n    "
  },
  "examples": [],
  "status": "active",
  "author": "Clean-Code-Guild",
  "license": "MIT",
  "skillType": "rule"
}